# OpenCode Zen API credentials (the pipeline calls the OpenAI-compatible
# chat completions endpoint at https://opencode.ai/zen/v1). The default model
# deepseek-v4-flash-free is free and not billed to the OpenCode Go subscription.
OPENCODE_API_KEY=your_opencode_zen_api_key_here
# OPENCODE_API_BASE_URL=https://opencode.ai/zen/v1

# GitHub token for publishing (optional, only needed for push)
# GITHUB_TOKEN=your_github_token_here
